{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',

  packageRules: [
    {
      matchPackageNames: ['bun'],
      matchManagers: ['dockerfile', 'bun-version', 'npm'],
      groupName: 'Bun',
      commitMessageTopic: 'Bun',
    },

    // Database packages
    {
      matchPackageNames: ['pg', 'typeorm'],
      groupName: 'Database',
    },
  ],
}
