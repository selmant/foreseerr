<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="Build.props" />
  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Foreseerr.Jellyfin</AssemblyName>
    <RootNamespace>Foreseerr.Jellyfin</RootNamespace>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- LoggerMessage source generation; Jellyfin's own ruleset disables these too. -->
    <NoWarn>$(NoWarn);CA1848;CA1873</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Jellyfin.Controller" Version="$(JellyfinVersion)">
      <PrivateAssets>all</PrivateAssets>
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Jellyfin.Data" Version="$(JellyfinVersion)">
      <PrivateAssets>all</PrivateAssets>
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Foreseerr.Jellyfin.Tests" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Pages/configPage.html" LogicalName="Foreseerr.Jellyfin.Pages.configPage.html" />
    <EmbeddedResource Include="Web/inject.html" LogicalName="Foreseerr.Jellyfin.Web.inject.html" />
    <EmbeddedResource Include="Web/loader.js" LogicalName="Foreseerr.Jellyfin.Web.loader.js" />
  </ItemGroup>
</Project>
