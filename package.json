{
  "name": "foreseerr",
  "version": "0.14.1",
  "private": true,
  "packageManager": "bun@1.4.1",
  "scripts": {
    "preinstall": "bun scripts/only-bun.mjs",
    "dev": "bun --bun ./node_modules/concurrently/dist/bin/concurrently.js -k -n api,web -c blue,green \"bun run dev:server\" \"bun run dev:web\"",
    "dev:server": "cd backend-rs && FORESEERR_APP_ROOT=.. cargo run --locked",
    "dev:web": "bun --bun ./node_modules/vite/bin/vite.js",
    "build:web": "bun --bun ./node_modules/vite/bin/vite.js build",
    "build:server": "cd backend-rs && cargo build --release --locked",
    "build": "bun run build:web && bun run build:server",
    "build:runtime": "scripts/build-runtime.sh",
    "lint": "bun scripts/eslint.mjs \"./src/**/*.{ts,tsx}\" \"./shared/**/*.ts\" --cache",
    "lintfix": "bun scripts/eslint.mjs \"./src/**/*.{ts,tsx}\" \"./shared/**/*.ts\" --fix",
    "test": "bun test --preload=./src/test/setup.ts --max-concurrency=1 --timeout=30000 src shared",
    "start": "NODE_ENV=production FORESEERR_APP_ROOT=. backend-rs/target/release/foreseerr",
    "i18n:extract": "bun scripts/extract-messages.ts",
    "format": "bun --bun ./node_modules/prettier/bin/prettier.cjs --log-level warn --write --cache .",
    "format:check": "bun --bun ./node_modules/prettier/bin/prettier.cjs --check --cache .",
    "typecheck": "bun --bun ./node_modules/typescript/bin/tsc --noEmit",
    "check:versions": "bun scripts/check-version-consistency.mjs",
    "mirror:packs": "bun scripts/mirror-mapping-packs.ts",
    "prepare": "bun bin/prepare.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/selmant/foreseerr.git"
  },
  "license": "MIT",
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@formatjs/intl-locale": "5.3.2",
    "@headlessui/react": "2.2.10",
    "@heroicons/react": "2.2.0",
    "@react-spring/web": "^10.0.3",
    "@seerr-team/react-tailwindcss-datepicker": "^1.3.4",
    "@tanem/react-nprogress": "6.0.3",
    "ace-builds": "1.43.6",
    "axios": "1.18.0",
    "bowser": "2.14.1",
    "copy-to-clipboard": "4.0.0",
    "country-flag-icons": "1.6.16",
    "cronstrue": "3.14.0",
    "formik": "^2.4.9",
    "humanize-duration": "^3.33.2",
    "ip-address": "^10.3.1",
    "lodash": "4.18.1",
    "react": "19.2.6",
    "react-ace": "14.0.1",
    "react-animate-height": "3.2.3",
    "react-aria": "3.47.0",
    "react-dom": "19.2.6",
    "react-helmet-async": "^2.0.5",
    "react-hot-toast": "^2.6.0",
    "react-intersection-observer": "10.0.3",
    "react-intl": "^7.1.14",
    "react-markdown": "10.1.0",
    "react-popper-tooltip": "4.4.2",
    "react-router": "^7.9.1",
    "react-select": "5.10.2",
    "react-transition-group": "^4.4.5",
    "react-truncate-markup": "5.1.2",
    "react-use-clipboard": "1.0.9",
    "swagger-ui-dist": "5.17.14",
    "swr": "2.4.1",
    "tailwind-merge": "^2.6.1",
    "ua-parser-js": "^2.0.10",
    "validator": "^13.15.35",
    "yup": "1.7.1",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@commitlint/cli": "20.5.0",
    "@commitlint/config-conventional": "20.5.0",
    "@eslint/js": "9.39.3",
    "@tailwindcss/aspect-ratio": "^0.4.2",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.19",
    "@types/country-flag-icons": "1.2.2",
    "@types/eslint-plugin-jsx-a11y": "^6.10.1",
    "@types/humanize-duration": "^3.27.4",
    "@types/lodash": "4.17.24",
    "@types/node": "22.19.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/react-transition-group": "4.4.12",
    "@types/ua-parser-js": "^0.7.36",
    "@types/validator": "^13.15.10",
    "@vitejs/plugin-react": "^5.0.2",
    "autoprefixer": "^10.5.0",
    "baseline-browser-mapping": "^2.10.18",
    "commitizen": "4.3.1",
    "concurrently": "^9.2.1",
    "cz-conventional-changelog": "3.3.0",
    "eslint": "9.39.3",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-formatjs": "6.4.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-no-relative-import-paths": "1.6.1",
    "eslint-plugin-prettier": "5.5.5",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "^17.5.0",
    "husky": "9.1.7",
    "jiti": "^2.6.1",
    "lint-staged": "16.4.0",
    "postcss": "^8.5.23",
    "prettier": "3.8.2",
    "prettier-plugin-organize-imports": "4.3.0",
    "prettier-plugin-tailwindcss": "0.7.2",
    "tailwindcss": "3.4.19",
    "typescript": "7.0.2",
    "typescript-classic": "npm:typescript@6.0.3",
    "typescript-eslint": "^8.58.2",
    "vite": "^7.1.5",
    "vite-plugin-svgr": "^4.5.0"
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "trustedDependencies": [
    "@swc/core",
    "esbuild",
    "sharp"
  ],
  "overrides": {
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "lint-staged": {
    "**/*.{ts,tsx,js}": [
      "bun --bun ./node_modules/prettier/bin/prettier.cjs --write --no-cache",
      "bun scripts/eslint.mjs"
    ],
    "**/*.{json,md,css}": [
      "bun --bun ./node_modules/prettier/bin/prettier.cjs --write --no-cache"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "scarfSettings": {
    "enabled": false
  }
}
