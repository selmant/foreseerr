{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "bundler",
    "outDir": "../dist",
    "noEmit": false,
    "incremental": true,
    "rootDir": "..",
    "paths": {
      "@server/*": ["./*"]
    }
  },
  "include": ["**/*.ts", "types/**/*.d.ts"]
}
